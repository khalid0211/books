# Copy this file to .env
# SQLite database file. Path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Sole Owner; other users must be added through Manage users.
OWNER_EMAIL=khalid0211@gmail.com
# Generate a random secret of at least 32 characters. Never commit the real value.
AUTH_SECRET=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Enrichment API keys entered by the Owner are encrypted with this server secret.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Retain it separately from database backups. Never change it without re-entering the API key.
ENRICHMENT_SECRET=
# Set false to disable background processing (for example during isolated testing).
ENRICHMENT_WORKER_ENABLED=true

# To switch to Postgres later, change the provider in prisma/schema.prisma to
# "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/books?schema=public"
