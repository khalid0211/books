generator client {
  provider = "prisma-client-js"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  role String @default("VIEW")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  loans Loan[]
}

model Session {
  tokenHash String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model LoginCode {
  id Int @id @default(autoincrement())
  email String
  hash String
  attempts Int @default(0)
  consumed Boolean @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([email, createdAt])
}

model Room {
  id Int @id @default(autoincrement())
  name String
  code String @unique
  cabinets Cabinet[]
}

model Cabinet {
  id Int @id @default(autoincrement())
  number Int
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  shelves Shelf[]
  @@unique([roomId, number])
}

model Shelf {
  id Int @id @default(autoincrement())
  number Int
  cabinetId Int
  cabinet Cabinet @relation(fields: [cabinetId], references: [id])
  @@unique([cabinetId, number])
}

datasource db {
  // Switch this to "postgresql" and update DATABASE_URL in .env to move to Postgres.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BookOwner {
  id Int @id @default(autoincrement())
  name String
  nameKey String @unique
  books Book[]
}

model Book {
  enrichment BookEnrichment?
  enrichmentItems EnrichmentJobItem[]
  loans Loan[]
  bookType String?
  categories Category[]
  ownerId Int?
  owner BookOwner? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  id              Int      @id @default(autoincrement())
  title           String
  authors         String // free text; comma-separate multiple authors
  isbn10          String?
  isbn13          String?
  publisher       String?
  publicationDate String? // ISO date string "YYYY-MM-DD" (kept as text for simple form handling)
  edition         String?
  language        String?
  pageCount       Int?
  tags            String? // comma-separated
  format          String? // hardcover | paperback | ebook | audiobook | other
  shelfLocation   String?
  dateAcquired    String? // ISO date string "YYYY-MM-DD"
  price           Float?
  rating          Int? // 1-5
  coverImageUrl   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@index([authors])
}

model Category {
  id Int @id @default(autoincrement())
  name String
  nameKey String @unique
  books Book[]
}

model Loan {
  id Int @id @default(autoincrement())
  bookId Int
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)
  borrowerId Int
  borrower User @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  // Cleared on return. The unique key prevents concurrent checkouts of one copy.
  activeBookId Int? @unique
  borrowedAt DateTime
  dueAt DateTime
  returnedAt DateTime?
  reminderAttemptAt DateTime?
  reminderSentAt DateTime?
  @@index([returnedAt, dueAt])
}

model EnrichmentSettings {
  id Int @id @default(1)
  encryptedKey String?
  model String @default("")
  inputRate Float @default(0)
  outputRate Float @default(0)
  budgetUsd Float @default(1)
  maxBooks Int @default(10)
  updatedAt DateTime @updatedAt
}

model BookEnrichment {
  bookId Int @id
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  manuallyLocked Boolean @default(false)
  autoApprovalBlocked Boolean @default(false)
  publishedRevisionId Int? @unique
  publishedRevision BookEnrichmentRevision? @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions BookEnrichmentRevision[] @relation("EnrichmentRevisions")
}

model BookEnrichmentRevision {
  id Int @id @default(autoincrement())
  bookId Int
  enrichment BookEnrichment @relation("EnrichmentRevisions", fields: [bookId], references: [bookId], onDelete: Cascade)
  publishedFor BookEnrichment? @relation("PublishedRevision")
  inputFingerprint String
  inputSnapshot String
  generatedOutput String @default("")
  olWorkId String?
  olEditionId String?
  olDescription String?
  olSourceUrl String?
  sourceSnapshot String
  sourceType String @default("legacy")
  modelIdentityStatus String?
  olIdentityStatus String?
  identityStatus String
  knowledgeLevel String
  overview String?
  centralIdea String?
  limitations String
  reviewStatus String @default("needs_review")
  approvalSource String?
  approvedAt DateTime?
  autoApprovalCheckedAt DateTime?
  approvalNote String?
  model String
  promptVersion String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCostUsd Float @default(0)
  createdAt DateTime @default(now())
  editedAt DateTime?
  concepts BookConcept[]
  jobItems EnrichmentJobItem[]
  @@index([bookId, createdAt])
}

model Concept {
  id Int @id @default(autoincrement())
  name String
  nameKey String @unique
  aliases ConceptAlias[]
  assignments BookConcept[]
}

model ConceptAlias {
  nameKey String @id
  conceptId Int
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

model BookConcept {
  id Int @id @default(autoincrement())
  revisionId Int
  revision BookEnrichmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  conceptId Int?
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  originalTerm String
  proposedName String
  weight Float
  perspective String?
  provenance String @default("llm_inferred")
  reviewStatus String @default("proposed")
  @@index([conceptId, revisionId])
}

model EnrichmentJob {
  id Int @id @default(autoincrement())
  startId Int
  endId Int
  regenerate Boolean @default(false)
  status String @default("queued")
  model String
  inputRate Float
  outputRate Float
  budgetUsd Float
  accountedUsd Float @default(0)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  message String?
  summarySavedAt DateTime?
  summaryBooksProcessed Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items EnrichmentJobItem[]
}

model EnrichmentJobItem {
  id Int @id @default(autoincrement())
  jobId Int
  job EnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bookId Int
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  revisionId Int?
  revision BookEnrichmentRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  status String @default("queued")
  attempts Int @default(0)
  error String?
  nextAttemptAt DateTime @default(now())
  @@unique([jobId, bookId])
  @@index([status, nextAttemptAt])
}

model EnrichmentWorkerLease {
  id Int @id @default(1)
  token String
  expiresAt DateTime
}
